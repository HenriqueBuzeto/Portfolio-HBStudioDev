# Supabase (obrigatório para /admin)
# Use apenas a URL do projeto e a chave "anon public". Nunca use NEXT_PUBLIC_ com service_role.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# E-mail único autorizado a acessar /admin (obrigatório)
ALLOWED_ADMIN_EMAIL=seu@email.com

# Caminho do PDF modelo para contratos (posições fixas). Padrão: public/contrato.pdf
# CONTRACT_PDF_TEMPLATE_PATH=public/contrato.pdf

# PDF com campos de formulário (AcroForm). Padrão: public/contrato_hb_studio_dev.pdf
# CONTRACT_PDF_FORM_TEMPLATE_PATH=public/contrato_hb_studio_dev.pdf
